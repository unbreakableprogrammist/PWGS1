<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF - Zadanie z Canvasem" Height="450" Width="800"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ContextMenu x:Key="ShapeContextMenu">
            <MenuItem Header="Zmień kolor na czerwony" Click="ChangeColor_Click"/>
            <MenuItem Header="Usuń kształt" Click="DeleteShapeMenu_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#EEE">
            <Button Content="Dodaj Kwadrat" Click="AddShape_Click" Margin="0,0,15,0"/>
            <TextBlock Text="Rozmiar (Data Binding): " VerticalAlignment="Center"/>

            <Slider x:Name="SizeSlider" Minimum="30" Maximum="200" Value="80" Width="150" VerticalAlignment="Center" Margin="5,0"/>

            <TextBlock Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Canvas x:Name="MainCanvas" Background="White" Focusable="True"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseDown="Canvas_MouseDown">
        </Canvas>
    </DockPanel>
</Window>
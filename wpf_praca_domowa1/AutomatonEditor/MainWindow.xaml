<!-- Główne okno aplikacji -->
<Window
    x:Class="AutomatonEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    Title="Edytor Automatów"
    Width="800"
    Height="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Menu główne z importem/eksportem -->
        <Menu Grid.Row="0">
            <MenuItem Header="Plik">
                <MenuItem Header="Import" Click="Import_Click" />
                <MenuItem Header="Eksport JSON" Click="ExportJson_Click" />
                <MenuItem Header="Eksport obraz" Click="ExportImage_Click" />
            </MenuItem>
        </Menu>
        <!-- Główna część okna: panel boczny + płótno -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <!-- Lewy panel z kontrolkami -->
        <Border Grid.Column="0" Background="LightGray" BorderBrush="LightGray" 
                BorderThickness="0,0,1,0" Padding="15">
            <!-- wlaczamy scroll -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <!-- Sekcja edycji stanu: aktywna tylko gdy stan jest zaznaczony.
                     IsEnabled jest powiązane z IsStateSelected, czyli zwykłym bool-->
                <StackPanel IsEnabled="{Binding IsStateSelected}">
                    <TextBlock Text="Edycja stanu" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                    <TextBlock Text="{Binding SelectedState.Name, StringFormat='Wybrany stan: {0}'}" FontSize="14" Margin="0,0,0,15" />
                    <CheckBox Content="Oznacz jako początkowy" IsChecked="{Binding SelectedState.IsInitial}" Click="InitialState_Click" Margin="0,0,0,10"/>
                    <CheckBox Content="Oznacz jako akceptujący" IsChecked="{Binding SelectedState.IsAccepting}" Margin="0,0,0,20"/>
                    <!-- tu zmieniamy selectedstate.fillbrush -> onproperty sie zmienia i elipsa sie aktualizuje -->
                    <TextBlock Text="Kolor wypełnienia" Margin="0,0,0,5" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedState.FillBrush}" Margin="0,0,0,10">
                        <ComboBoxItem Content="Jasny niebieski" Tag="{x:Static media:Brushes.LightBlue}" />
                        <ComboBoxItem Content="Jasny zielony" Tag="{x:Static media:Brushes.LightGreen}" />
                        <ComboBoxItem Content="Jasny żółty" Tag="{x:Static media:Brushes.LightYellow}" />
                        <ComboBoxItem Content="Jasny róż" Tag="{x:Static media:Brushes.LightPink}" />
                        <ComboBoxItem Content="Biały" Tag="{x:Static media:Brushes.White}" />
                    </ComboBox>

                    <TextBlock Text="Kolor krawędzi" Margin="0,0,0,5" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedState.StrokeBrush}" Margin="0,0,0,10">
                                <ComboBoxItem Content="Czarny" Tag="{x:Static media:Brushes.Black}" />
                                <ComboBoxItem Content="Granatowy" Tag="{x:Static media:Brushes.DarkBlue}" />
                                <ComboBoxItem Content="Czerwony" Tag="{x:Static media:Brushes.DarkRed}" />
                                <ComboBoxItem Content="Zielony" Tag="{x:Static media:Brushes.DarkGreen}" />
                                <ComboBoxItem Content="Szary" Tag="{x:Static media:Brushes.DimGray}" />
                            </ComboBox>
                            <TextBlock Text="Promień" Margin="0,0,0,5" />
                    <Slider Minimum="15" Maximum="60" Value="{Binding SelectedState.Radius}" Margin="0,0,0,10" />

                    <TextBlock Text="Grubość krawędzi" Margin="0,0,0,5" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding SelectedState.StrokeThickness}" Margin="0,0,0,10" />
                    <Button Content="Usuń stan" Click="DeleteState_Click" Padding="5" />
                </StackPanel>

                <Separator Margin="0,20,0,20" />
                <!-- przejscia i dodawanie alfabetu -->
                <StackPanel>
                    <TextBlock Text="Dodaj przejście" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />

                    <TextBlock Text="Od stanu:" Margin="0,0,0,5" />
                    <ComboBox x:Name="ComboFrom" ItemsSource="{Binding MyAutomaton.States}" DisplayMemberPath="Name" Margin="0,0,0,10" />

                    <TextBlock Text="Do stanu:" Margin="0,0,0,5" />
                    <ComboBox x:Name="ComboTo" ItemsSource="{Binding MyAutomaton.States}" DisplayMemberPath="Name" Margin="0,0,0,10" />

                    <TextBlock Text="Etykieta :" Margin="0,0,0,5" />
                    <TextBox x:Name="TextSymbol" Margin="0,0,0,15" />

                    <Button Content="Dodaj przejście" Click="AddTransition_Click" Padding="5" />
                    <Button Content="Usuń przejście" Click="DeleteTransition_Click" Padding="5" Margin="0,10,0,0"
                            IsEnabled="{Binding IsTransitionSelected}" />

                    <TextBlock Text="Alfabet:" Margin="0,20,0,5" FontWeight="Bold" />
                    <TextBlock Text="{Binding AlphabetDisplay}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- symulacja  -->
                <Separator Margin="0,20,0,20" />
                <StackPanel>    
                    <TextBlock Text="Symulacja" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                    <TextBlock Text="Słowo wejściowe:" Margin="0,0,0,5" />
                    <!--aktualizujemy ze aktualizujemy tekst zawsze jak klikniemy nowy przycisk, IsReadOnly blokuje nam tekst w trakcie symulacji-->
                    <TextBox Text="{Binding InputWord, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputLocked}" Margin="0,0,0,10">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- to te literki/cyferki na dole, ta co rozpatrujemy podswietlamy na niebiesko -->
                    <ItemsControl ItemsSource="{Binding InputWordSymbols}" Margin="0,0,0,10" MinHeight="24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,2" Margin="0,0,2,2" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="DodgerBlue" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Black" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Przyciski do symulacji, IsEnabled jest wtedy true gdy nie robimy automatycznej symulacji -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Previous" Click="Previous_Click" Padding="5" Margin="0,0,10,0" IsEnabled="{Binding CanPrevious}" />
                        <Button Content="Next" Click="Next_Click" Padding="5" IsEnabled="{Binding CanNext}" />
                    </StackPanel>

                    <!-- Przyciski trybu animacji. Timer wykonuje te same kroki co
                         przycisk Next, tylko automatycznie w ustalonym odstępie czasu. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Start" Click="Start_Click" Padding="5" Margin="0,0,10,0" IsEnabled="{Binding CanStart}" />
                        <Button Content="Stop" Click="Stop_Click" Padding="5" Margin="0,0,10,0" IsEnabled="{Binding CanStop}" />
                        <Button Content="Reset" Click="Reset_Click" Padding="5" IsEnabled="{Binding CanReset}" />
                    </StackPanel>

                    <TextBlock Text="Szybkość" Margin="0,0,0,5" />
                    <Slider Minimum="0.2" Maximum="2.0" Value="{Binding AnimationSpeed}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding SimulationStatus}" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Text="Historia" Margin="0,20,0,5" FontWeight="Bold" />
                    <!-- Historia kroków symulacji -->
                    <ListBox ItemsSource="{Binding History}" Height="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StateName}" FontWeight="Bold" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Symbol}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- Płótno z automatami -->
        <Grid x:Name="CanvasHost" Grid.Column="1" Background="White" MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
            <!-- W wpf to co narysujemy najpierw jest przed wiec najpierw strzalki-->
            <ItemsControl ItemsSource="{Binding MyAutomaton.Transitions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <!-- Path rysuje linię lub krzywą przejścia. Dane geometrii
                                 są liczone w klasie Transition na podstawie pozycji stanów źródłowego i docelowego. -->
                            <Path Data="{Binding PathGeometry}"
                                  Stroke="Transparent"
                                  StrokeThickness="12"
                                  MouseLeftButtonDown="Transition_MouseLeftButtonDown" />
                            <Path Data="{Binding PathGeometry}" MouseLeftButtonDown="Transition_MouseLeftButtonDown">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="Black" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="DodgerBlue" />
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="DarkRed" />
                                                <Setter Property="StrokeThickness" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!--grot strzalki -->
                            <Polygon Points="{Binding ArrowPoints}" MouseLeftButtonDown="Transition_MouseLeftButtonDown">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="Fill" Value="Black" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="DodgerBlue" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Fill" Value="DarkRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>

                            <!-- Etykieta przejścia również jest ItemsControl. Bo dzieki temu tez mozna ja pokolorowac przy symulacji -->
                            <ItemsControl ItemsSource="{Binding SymbolParts}"
                                          Canvas.Left="{Binding TextX}"
                                          Canvas.Top="{Binding TextY}"
                                          Margin="10,-15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,0" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="DodgerBlue" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="DarkBlue" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Warstwa kolek. -->
            <ItemsControl ItemsSource="{Binding MyAutomaton.States}" Background="{x:Null}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="{x:Null}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding Diameter}" Height="{Binding Diameter}" Margin="{Binding NegativeRadiusMargin}" Background="Transparent" 
              MouseLeftButtonDown="State_MouseLeftButtonDown" 
              MouseMove="State_MouseMove"
              MouseLeftButtonUp="State_MouseLeftButtonUp">

                            <!-- Strzałka przy stanie początkowym jest domyślnie ukryta
                                 i pojawia się dopiero, gdy IsInitial == true. -->
                            <Path x:Name="InitialArrow" 
                  Data="M -20 25 L 0 25 M -5 20 L 0 25 L -5 30" 
                  Stroke="Black" StrokeThickness="2" 
                  Visibility="Collapsed" />

                            <!-- Główny okrąg stanu. FillBrush, StrokeBrush,
                                 StrokeThickness i promień są bindowane do modelu,
                                 więc zmiany z panelu po lewej od razu zmieniają rysunek. -->
                            <Ellipse x:Name="MainCircle" Fill="{Binding FillBrush}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                        <Setter Property="StrokeThickness" Value="{Binding StrokeThickness}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="DodgerBlue" />
                                                <Setter Property="StrokeThickness" Value="4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="Red" />
                                                <Setter Property="StrokeThickness" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Drugi, mniejszy okrąg oznacza ze stan jest akceptujący -->
                            <Ellipse x:Name="AcceptingCircle" 
                     Width="{Binding AcceptingDiameter}" Height="{Binding AcceptingDiameter}" 
                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeThickness}" 
                     Fill="Transparent" 
                     Visibility="Collapsed" 
                     IsHitTestVisible="False" />

                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <!-- Triggery DataTemplate reagują na właściwości stanu i
                             pokazują symbole specjalne: podwójny okrąg dla stanu
                             akceptującego oraz strzałkę dla stanu początkowego. -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAccepting}" Value="True">
                                <Setter TargetName="AcceptingCircle" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsInitial}" Value="True">
                                <Setter TargetName="InitialArrow" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Grid>
    </Grid>
</Window>

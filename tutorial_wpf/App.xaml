<!--
    Główny plik aplikacji WPF.
    To tutaj ustawiane są zasoby globalne i okno startowe programu.
-->
<Application x:Class="tutorial_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:tutorial_wpf"
             StartupUri="MainWindow.xaml">
    <!--
        StartupUri wskazuje pierwsze okno uruchamiane po starcie aplikacji.
        W tym projekcie jest to MainWindow.xaml.
    -->
    <Application.Resources>
        <!--
            Zasoby globalne aplikacji.
            Gdybyśmy dodali tu style/szablony, byłyby dostępne we wszystkich oknach.
        -->
    </Application.Resources>
</Application>

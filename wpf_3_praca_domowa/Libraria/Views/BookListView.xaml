<UserControl x:Class="Libraria.Views.BookListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Libraria.Controls"
             xmlns:converters="clr-namespace:Libraria.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TileBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#EEF0F3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                                <Setter TargetName="TileBorder" Property="Background" Value="#FFF0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D8DDE6"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Search"
                           Style="{StaticResource FilterLabelStyle}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="220"
                         Margin="0,0,14,0"
                         Padding="8,4" />

                <TextBlock Text="Status"
                           Style="{StaticResource FilterLabelStyle}" />
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="Name"
                          Width="130"
                          Margin="0,0,14,0" />

                <TextBlock Text="Rating"
                           Style="{StaticResource FilterLabelStyle}" />
                <ComboBox ItemsSource="{Binding RatingFilters}"
                          SelectedItem="{Binding SelectedRatingFilter}"
                          DisplayMemberPath="Name"
                          Width="120"
                          Margin="0,0,14,0" />

                <TextBlock Text="Sort"
                           Style="{StaticResource FilterLabelStyle}" />
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          DisplayMemberPath="Name"
                          Width="120"
                          Margin="0,0,14,0" />

                <Button Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="12,4" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding FilteredBooks}"
                         SelectedItem="{Binding DataContext.SelectedBook, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="18" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <StackPanel Width="152" Margin="6">
                                    <Border Width="120"
                                            Height="160"
                                            Background="#E6E8EC"
                                            BorderBrush="#C6CAD1"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CoverImage, Converter={StaticResource ByteArrayToImageConverter}}"
                                                   Stretch="UniformToFill" />
                                            <TextBlock Text="No Cover"
                                                       Foreground="#6B7280"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverImage.Length}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="42"
                                               Margin="0,8,0,2" />
                                    <TextBlock Text="{Binding Author}"
                                               TextAlignment="Center"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="34" />
                                    <controls:TagControl Tags="{Binding Tags}"
                                                         IsEditable="False"
                                                         Margin="0,6,0,0" />
                                    <controls:RatingControl Value="{Binding Rating}"
                                                            IsReadOnly="True"
                                                            StarSize="18"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock Text="No books match the current filters."
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredBooks.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>

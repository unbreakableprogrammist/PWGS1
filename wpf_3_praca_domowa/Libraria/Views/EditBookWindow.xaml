<Window x:Class="Libraria.Views.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Libraria.Controls"
        xmlns:converters="clr-namespace:Libraria.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Resources/book.ico"
        Width="720"
        Height="680"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cover"
                               Style="{StaticResource FieldLabelStyle}" />
                    <Border Width="120"
                            Height="160"
                            Background="#E6E8EC"
                            BorderBrush="#C6CAD1"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding CoverImage, Converter={StaticResource ByteArrayToImageConverter}}"
                                   Stretch="UniformToFill" />
                            <TextBlock Text="No Cover"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCoverImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Content="Browse Image..."
                            Command="{Binding BrowseCoverCommand}"
                            Margin="0,10,0,18"
                            Padding="10,6"
                            HorizontalAlignment="Left" />

                    <TextBlock Text="Rating"
                               Style="{StaticResource FieldLabelStyle}" />
                    <controls:RatingControl Value="{Binding Rating, Mode=TwoWay}"
                                            IsReadOnly="False"
                                            Margin="0,0,0,18" />

                    <TextBlock Text="Status"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status}"
                              Width="150"
                              HorizontalAlignment="Left" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Title"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Author"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Description"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="96"
                                 Padding="8,5"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <TextBlock Text="Genre"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,12">
                        <TextBlock Text="Tags"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Add"
                                    Command="{Binding AddTagCommand}"
                                    Padding="12,5"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" />
                        </DockPanel>
                        <controls:TagControl Tags="{Binding Tags}"
                                             IsEditable="True"
                                             RemoveTagCommand="{Binding RemoveTagCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,12">
                        <TextBlock Text="Book File"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Browse Book..."
                                    Command="{Binding BrowseBookCommand}"
                                    Padding="12,5"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding FilePath}"
                                     IsReadOnly="True"
                                     Padding="8,5" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Page Count"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 HorizontalAlignment="Left"
                                 Padding="8,5" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D8DDE6"
                BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource AccentColor}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="20,7"
                        Margin="0,0,8,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Padding="20,7" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

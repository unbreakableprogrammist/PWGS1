<UserControl x:Class="Libraria.Controls.TagControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Libraria.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Tags, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{Binding ChipBackground, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}}"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="0,0,6,6">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Command="{Binding RemoveTagCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{Binding ChipForeground, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}}"
                                FontWeight="Bold"
                                Padding="4,0"
                                Margin="4,0,0,0" />
                        <TextBlock Text="{Binding}"
                                   Foreground="{Binding ChipForeground, RelativeSource={RelativeSource AncestorType={x:Type controls:TagControl}}}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Value, ElementName=Root, Converter={StaticResource RatingStarTextConverter}, ConverterParameter=3}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star3Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star4Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star5Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <Button x:Name="Star4Button"
                CommandParameter="4"
                Style="{StaticResource StarButtonStyle}">
            <TextBlock FontSize="{Binding StarSize, ElementName=Root}"
                       Foreground="#D6A100">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Value, ElementName=Root, Converter={StaticResource RatingStarTextConverter}, ConverterParameter=4}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star4Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star5Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <Button x:Name="Star5Button"
                CommandParameter="5"
                Style="{StaticResource StarButtonStyle}">
            <TextBlock FontSize="{Binding StarSize, ElementName=Root}"
                       Foreground="#D6A100">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Value, ElementName=Root, Converter={StaticResource RatingStarTextConverter}, ConverterParameter=5}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star5Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
    </StackPanel>
</UserControl>

<UserControl x:Class="Libraria.Controls.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Libraria.Controls"
             xmlns:converters="clr-namespace:Libraria.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:RatingStarTextConverter x:Key="RatingStarTextConverter" />

        <Style x:Key="StarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Command" Value="{Binding SetRatingCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}" Value="True">
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button x:Name="Star1Button"
                CommandParameter="1"
                Style="{StaticResource StarButtonStyle}">
            <TextBlock FontSize="{Binding StarSize, ElementName=Root}"
                       Foreground="#D6A100">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Value, ElementName=Root, Converter={StaticResource RatingStarTextConverter}, ConverterParameter=1}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star1Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star2Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star3Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star4Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star5Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <Button x:Name="Star2Button"
                CommandParameter="2"
                Style="{StaticResource StarButtonStyle}">
            <TextBlock FontSize="{Binding StarSize, ElementName=Root}"
                       Foreground="#D6A100">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Value, ElementName=Root, Converter={StaticResource RatingStarTextConverter}, ConverterParameter=2}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star2Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star3Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star4Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReadOnly, ElementName=Root}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Star5Button}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="★" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <Button x:Name="Star3Button"
                CommandParameter="3"
                Style="{StaticResource StarButtonStyle}">
            <TextBlock FontSize="{Binding StarSize, ElementName=Root}"
                       Foreground="#D6A100">

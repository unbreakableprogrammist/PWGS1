<UserControl x:Class="Libraria.Controls.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Libraria.Controls"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Star1"
                   Tag="1"
                   Text="☆"
                   FontSize="{Binding StarSize, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}"
                   Foreground="#D6A100"
                   Cursor="Hand"
                   MouseEnter="Star_MouseEnter"
                   MouseLeave="Star_MouseLeave"
                   MouseLeftButtonDown="Star_MouseLeftButtonDown" />
        <TextBlock x:Name="Star2"
                   Tag="2"
                   Text="☆"
                   FontSize="{Binding StarSize, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}"
                   Foreground="#D6A100"
                   Cursor="Hand"
                   MouseEnter="Star_MouseEnter"
                   MouseLeave="Star_MouseLeave"
                   MouseLeftButtonDown="Star_MouseLeftButtonDown" />
        <TextBlock x:Name="Star3"
                   Tag="3"
                   Text="☆"
                   FontSize="{Binding StarSize, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}"
                   Foreground="#D6A100"
                   Cursor="Hand"
                   MouseEnter="Star_MouseEnter"
                   MouseLeave="Star_MouseLeave"
                   MouseLeftButtonDown="Star_MouseLeftButtonDown" />
        <TextBlock x:Name="Star4"
                   Tag="4"
                   Text="☆"
                   FontSize="{Binding StarSize, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}"
                   Foreground="#D6A100"
                   Cursor="Hand"
                   MouseEnter="Star_MouseEnter"
                   MouseLeave="Star_MouseLeave"
                   MouseLeftButtonDown="Star_MouseLeftButtonDown" />
        <TextBlock x:Name="Star5"
                   Tag="5"
                   Text="☆"
                   FontSize="{Binding StarSize, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}"
                   Foreground="#D6A100"
                   Cursor="Hand"
                   MouseEnter="Star_MouseEnter"
                   MouseLeave="Star_MouseLeave"
                   MouseLeftButtonDown="Star_MouseLeftButtonDown" />
    </StackPanel>
</UserControl>

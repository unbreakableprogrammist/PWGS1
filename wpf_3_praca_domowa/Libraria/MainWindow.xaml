<Window x:Class="Libraria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libraria"
        xmlns:controls="clr-namespace:Libraria.Controls"
        xmlns:vm="clr-namespace:Libraria.ViewModels"
        xmlns:views="clr-namespace:Libraria.Views"
        mc:Ignorable="d"
        Title="Libraria"
        Icon="/Resources/book.ico"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="920">
    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteBookCommand}" />
    </Window.InputBindings>
    <!--w zaleznosci jakie dane dostaniemy to wyswieltamy je w konkretny wudok z katalogu views-->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BookListViewModel}">
            <views:BookListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BookDetailViewModel}">
            <views:BookDetailView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReaderViewModel}">
            <views:ReaderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_Repository">
                <MenuItem Header="_Create"
                          Command="{Binding CreateRepositoryCommand}" />
                <MenuItem Header="_Open"
                          Command="{Binding OpenRepositoryCommand}" />
            </MenuItem>
            <MenuItem Header="_Book">
                <MenuItem Header="_Add..."
                          Command="{Binding AddBookCommand}" />
                <MenuItem Header="_Edit..."
                          Command="{Binding EditBookCommand}" />
                <Separator />
                <MenuItem Header="_Delete..."
                          Command="{Binding DeleteBookCommand}"
                          InputGestureText="Delete" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource PrimaryColor}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Resources/book.png"
                       Width="38"
                       Height="38"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="Libraria"
                               Foreground="White"
                               FontFamily="Segoe Script"
                               FontSize="24"
                               FontWeight="SemiBold"
                               LineHeight="26" />
                    <TextBlock Text="Personal Book Manager"
                               Foreground="#C8D0DA"
                               FontSize="12" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding RepositoryName}"
                           Foreground="#C8D0DA"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

        <controls:StatisticsBarControl Grid.Row="3"
                                       TotalBooks="{Binding BookCount}"
                                       ReadBooks="{Binding ReadBookCount}"
                                       InProgressBooks="{Binding InProgressBookCount}"
                                       AverageRating="{Binding AverageRating}"
                                       TopGenre="{Binding TopGenre}"
                                       StatusMessage="{Binding StatusMessage}" />
    </Grid>
</Window>
